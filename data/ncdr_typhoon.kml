<Icon>
<href>https://satis.ncdr.nat.gov.tw/kml/logo01.png</href>
<viewBoundScale>0.4</viewBoundScale>
</Icon>
<overlayXY x="0.05" y="1" xunits="fraction" yunits="fraction"/>
<screenXY x="0.05" y="1"     xunits="fraction" yunits="fraction"/>
<rotationXY x="0.5" y="0.5" xunits="fraction" yunits="fraction"/>
<size x="-1" y="-1" xunits="pixels" yunits="pixels"/>
</ScreenOverlay>
</Document>
</kml>